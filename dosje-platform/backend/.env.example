# ==============================================================================
# STRIDE-X Backend Environment Configuration Template
# ==============================================================================

# Project Details
PROJECT_NAME="STRIDE-X API"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL / SQLite fallback)
# Production PostgreSQL example: postgresql+psycopg://postgres:postgres@localhost:5432/stride_x
# Development SQLite default: sqlite:///./stride_x.db
DATABASE_URL="sqlite:///./stride_x.db"

# Security & JWT Configuration
# Generate a secure secret in production using: openssl rand -hex 32
JWT_SECRET_KEY="stride_x_development_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
