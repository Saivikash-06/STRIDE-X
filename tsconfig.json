{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "./dosje-platform",
    "paths": {
      "@/*": [
        "src/*",
        "frontend/src/*",
        "./src/*",
        "./frontend/src/*",
        "dosje-platform/src/*",
        "dosje-platform/frontend/src/*"
      ]
    }
  },
  "include": [
    "dosje-platform/next-env.d.ts",
    "dosje-platform/frontend/next-env.d.ts",
    "dosje-platform/src/**/*.ts",
    "dosje-platform/src/**/*.tsx",
    "dosje-platform/frontend/src/**/*.ts",
    "dosje-platform/frontend/src/**/*.tsx"
  ],
  "exclude": [
    "dosje-platform/backend/**"
  ]
}
